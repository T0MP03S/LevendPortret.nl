# Public base URLs (dev defaults)
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_CLUB_URL=http://localhost:3001
NEXT_PUBLIC_CLIPS_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003

# Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Admin: Cloudflare R2 (optional for uploads)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Email (optional for dev/testing)
EMAIL_FROM=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_SECURE=false
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_REPLY_TO=info@levendportret.nl

# Error monitoring (optional)
SENTRY_DSN=

# Note:
# - In production, set NEXT_PUBLIC_* URLs to the HTTPS domains.
# - Set NEXTAUTH_URL per app (web/admin/club/fund) in its own environment, not globally.
