{
  "name": "levendportret-monorepo",
  "private": true,
  "packageManager": "pnpm@9.11.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv -e .env.local -- turbo run dev",
    "dev:web": "dotenv -e .env.local -- pnpm -C apps/web dev",
    "dev:club": "dotenv -e .env.local -- pnpm -C apps/club dev",
    "dev:fund": "dotenv -e .env.local -- pnpm -C apps/fund dev",
    "dev:admin": "dotenv -e .env.local -- pnpm -C apps/admin dev",
    "lint": "turbo run lint && node scripts/validate-scripts.mjs",
    "prisma:generate": "dotenv -e .env.local -- pnpm --filter @levendportret/db run prisma:generate",
    "prisma:migrate:dev": "dotenv -e .env.local -- pnpm --filter @levendportret/db run prisma:migrate:dev",
    "prisma:studio": "dotenv -e .env.local -- pnpm --filter @levendportret/db run prisma:studio",
    "scheduler": "dotenv -e .env.local -- node scripts/scheduler.js",
    "scheduler:watch": "dotenv -e .env.local -- node scripts/scheduler.js --watch"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^7.0.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.14",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "pnpm": "^9.11.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.10",
    "zod": "^4.1.12"
  }
}
